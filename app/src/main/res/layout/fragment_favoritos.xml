<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white">

    <!-- Header verde -->
    <LinearLayout
        android:id="@+id/headerFavoritos"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/color_default"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Voltar"
            android:src="@drawable/setavoltarpag"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/fontpoppins"
            android:gravity="center"
            android:text="Favoritos"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="24dp"
            android:layout_height="24dp" />

    </LinearLayout>

    <!-- Card branco com lista -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp"
        android:background="@drawable/bg_card_menu"
        android:clipToOutline="true"
        android:fillViewport="true"
        android:contentDescription="@string/content_description_favoritos">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="32dp">

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/recyclerFavoritos"
                tools:listitem="@layout/item_livro"
                android:visibility="visible"
                android:padding="8dp"
                android:clipToPadding="false"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/estadoVazio"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray_subtitle"
                    android:text="@string/nenhum_favorito"/>
            </LinearLayout>

            <!-- Card: Dom Quixote -->
            <!--<androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_bg_color">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgDomQuixote"
                        android:layout_width="64dp"
                        android:layout_height="90dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/domquixote"
                        android:contentDescription="Dom Quixote"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/imgDomQuixote"
                        android:layout_toStartOf="@+id/btnHeartDomQuixote"
                        android:layout_centerVertical="true"
                        android:orientation="vertical"
                        android:paddingStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fontpoppins"
                            android:text="Dom Quixote"
                            android:textColor="@color/dark_green"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fontpoppins"
                            android:text="Miguel de Cervantes"
                            android:textColor="@color/gray_subtitle"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fontpoppins"
                            android:text="Clássicos"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:layout_marginTop="8dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:background="@drawable/bg_tag_categoria" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnHeartDomQuixote"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_heart"
                        android:contentDescription="Remover dos favoritos"
                        app:tint="#D04F6B" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            &lt;!&ndash; Card: Crime e Castigo &ndash;&gt;
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_bg_color">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgCrime"
                        android:layout_width="64dp"
                        android:layout_height="90dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/crime"
                        android:contentDescription="Crime e Castigo"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/btnHeartCrime"
                        android:layout_toEndOf="@id/imgCrime"
                        android:orientation="vertical"
                        android:paddingStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fontpoppins"
                            android:text="Crime e Castigo"
                            android:textColor="@color/dark_green"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/fontpoppins"
                            android:text="Fiódor Dostoiévski"
                            android:textColor="@color/gray_subtitle"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_tag_categoria"
                            android:fontFamily="@font/fontpoppins"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="3dp"
                            android:text="Clássicos"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnHeartCrime"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="Remover dos favoritos"
                        android:src="@drawable/ic_heart"
                        app:tint="#D04F6B" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            &lt;!&ndash; Card: A Hora da Estrela &ndash;&gt;
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_bg_color">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgHoraEstrela"
                        android:layout_width="64dp"
                        android:layout_height="90dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/horadaestrela"
                        android:contentDescription="A Hora da Estrela"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/imgHoraEstrela"
                        android:layout_toStartOf="@+id/btnHeartHoraEstrela"
                        android:layout_centerVertical="true"
                        android:orientation="vertical"
                        android:paddingStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fontpoppins"
                            android:text="A Hora da Estrela"
                            android:textColor="@color/dark_green"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fontpoppins"
                            android:text="Clarice Lispector"
                            android:textColor="@color/gray_subtitle"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fontpoppins"
                            android:text="Brasileiros"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:layout_marginTop="8dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:background="@drawable/bg_tag_categoria" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnHeartHoraEstrela"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_heart"
                        android:contentDescription="Remover dos favoritos"
                        app:tint="#D04F6B" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            &lt;!&ndash; Card: Laranja Mecânica &ndash;&gt;
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_bg_color">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgLaranjaMecanica"
                        android:layout_width="64dp"
                        android:layout_height="90dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/floresparalg"
                        android:contentDescription="Laranja Mecânica"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/imgLaranjaMecanica"
                        android:layout_toStartOf="@+id/btnHeartLaranja"
                        android:layout_centerVertical="true"
                        android:orientation="vertical"
                        android:paddingStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fontpoppins"
                            android:text="Flores para Algernon"
                            android:textColor="@color/dark_green"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fontpoppins"
                            android:text="Keys, Daniel"
                            android:textColor="@color/gray_subtitle"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fontpoppins"
                            android:text="Internacionais"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:layout_marginTop="8dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:background="@drawable/bg_tag_categoria" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnHeartLaranja"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_heart"
                        android:contentDescription="Remover dos favoritos"
                        app:tint="#D04F6B" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>-->

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>