<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_header_perfil">

    <!-- Header verde -->
    <LinearLayout
        android:id="@+id/headerPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_perfil"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="0dp">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/setavoltarpag"
            app:tint="#FFFFFF" />

        <!-- Avatar com borda branca -->
        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="@drawable/bg_avatar_circle"
                android:padding="14dp"
                android:src="@drawable/ic_perfil2"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvNomeUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fontpoppins"
            android:text="@string/perfil_nome_exemplo"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />



    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="195dp"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_card_menu"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_verde_suave"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#477740"
                        android:fontFamily="@font/fontpoppins" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perfil_stat_lidos"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:fontFamily="@font/fontpoppins" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_verde_suave"
                    android:padding="12dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#477740"
                        android:fontFamily="@font/fontpoppins" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perfil_stat_reservas"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:fontFamily="@font/fontpoppins" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_verde_suave"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#477740"
                        android:fontFamily="@font/fontpoppins" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perfil_stat_avaliacoes"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:fontFamily="@font/fontpoppins" />
                </LinearLayout>

            </LinearLayout>

            <!-- divisor -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A477740"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnPagarMultas"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="@string/perfil_btn_pagar_multas"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/fontpoppins"
                android:backgroundTint="#477740"
                style="@style/Widget.MaterialComponents.Button"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnHistorico"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="@string/perfil_btn_historico"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/fontpoppins"
                android:backgroundTint="#477740"
                style="@style/Widget.MaterialComponents.Button"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnDadosPessoais"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="@string/perfil_btn_dados_pessoais"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/fontpoppins"
                android:backgroundTint="#477740"
                style="@style/Widget.MaterialComponents.Button"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnFavoritos"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="@string/perfil_btn_favoritos"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/fontpoppins"
                android:backgroundTint="#477740"
                style="@style/Widget.MaterialComponents.Button"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnAlterarSenha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:text="@string/perfil_btn_alterar_senha"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/fontpoppins"
                android:backgroundTint="#477740"
                style="@style/Widget.MaterialComponents.Button"
                app:cornerRadius="14dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A477740"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/perfil_btn_sair"
                android:textColor="#C0392B"
                android:textSize="15sp"
                android:fontFamily="@font/fontpoppins"
                android:backgroundTint="@android:color/transparent"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="14dp"
                app:strokeColor="#C0392B"
                app:strokeWidth="1.5dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>