<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FragmentAcervo"
    android:background="@color/white">


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/headerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/header_background"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="60dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fontpoppins"
                        android:textColor="#FFFFFF"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:paddingTop="5dp"
                        android:text="@string/acervo_titulo"/>

                    <EditText
                        android:id="@+id/searchBar"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/pesquisa"
                        android:drawableEnd="@drawable/lupa"
                        android:elevation="2dp"
                        android:inputType="text"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:hint="@string/acervo_hint_pesquisar"
                        />
                </LinearLayout>

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerBanners"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_below="@id/headerContainer"
                    android:layout_marginTop="-55dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp" />

            </RelativeLayout>
            <LinearLayout
                android:id="@+id/dotsIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:layout_below="@id/viewPagerBanners"
                android:orientation="horizontal"
                android:minHeight="16dp"
                android:visibility="visible">


            </LinearLayout>

            <!-- ===== Guia Principal / Gêneros ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginStart="18dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipPrincipal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/gb_chip_selecionado"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/fontpoppins"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/acervo_guia_principal"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipGeneros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_nao_selecionado"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/fontpoppins"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/acervo_guia_generos"
                    android:textColor="@color/color_default"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- ===== Conteúdo da guia "Principal" (o que já existia, agora dentro de um container) ===== -->
            <LinearLayout
                android:id="@+id/layoutConteudoPrincipal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtNomeGenero1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/GenreTitle"
                        android:paddingTop="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/outline_arrow_circle_right_24"
                        android:drawableTint="@color/color_default"
                        android:text="@string/genero_ver_mais"
                        android:drawablePadding="12dp"
                        style="@style/VerMaisGenero"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerGenero1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    tools:listitem="@layout/item_livro"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:paddingStart="18dp"
                    android:clipToPadding="false"/>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtNomeGenero2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/GenreTitle"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/outline_arrow_circle_right_24"
                        android:drawableTint="@color/color_default"
                        android:text="@string/genero_ver_mais"
                        android:drawablePadding="12dp"
                        style="@style/VerMaisGenero"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerGenero2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    tools:listitem="@layout/item_livro"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:paddingStart="18dp"
                    android:clipToPadding="false"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtNomeGenero3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/GenreTitle"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/outline_arrow_circle_right_24"
                        android:drawableTint="@color/color_default"
                        android:text="@string/genero_ver_mais"
                        android:drawablePadding="12dp"
                        style="@style/VerMaisGenero"/>

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerGenero3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    tools:listitem="@layout/item_livro"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:paddingStart="18dp"
                    android:clipToPadding="false"
                    android:paddingBottom="80dp"/>

            </LinearLayout>

            <!-- ===== Conteúdo da guia "Gêneros" (grid 2 colunas) ===== -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerGeneros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="80dp"
                android:clipToPadding="false"
                android:visibility="gone"
                tools:listitem="@layout/item_genero"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2" />


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>