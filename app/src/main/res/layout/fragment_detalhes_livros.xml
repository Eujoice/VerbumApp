<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:id="@+id/detalhesLivroLayout"
    tools:context=".ui.DetalhesLivroFragment">

    <!-- ===== HEADER VERDE ===== -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_header_perfil"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/setavoltarpag"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fontpoppins"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Detalhes"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ===== CARD BRANCO (começa em 170dp, deixando espaço pro livro sobrepor) ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="172dp"
        android:fillViewport="true"
        android:background="@drawable/bg_card_menu"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp"
            android:paddingTop="280dp">
            <!-- paddingTop reserva espaço para a capa que flutua por cima -->


            <TextView
                android:id="@+id/tvTituloLivro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fontpoppins"
                android:gravity="center"
                android:text="A Biblioteca da Meia Noite"
                android:textColor="#477740"
                android:textSize="25sp"
                android:textStyle="bold"
                />

            <TextView
                android:id="@+id/tvAutorLivro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/fontpoppins"
                android:gravity="center"
                android:text="Emily Bronte"
                android:textColor="#888888"
                android:textSize="16sp" />


            <TextView
                android:id="@+id/tvDescricaoLivro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fontpoppins"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="4"
                android:ellipsize="end"
                android:text="Clássico eterno da ficção científica, Flores para Algernon é um dos livros mais tocantes já escritos. A história de Charlie Gordon, um jovem com deficiência intelectual submetido a uma cirurgia experimental para aumentar sua inteligência, é narrada em forma de diário e transforma o leitor por completo."
                android:textColor="#555555"
                android:textSize="13sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="10dp"
                android:textAlignment="center"/>

            <TextView
                android:id="@+id/tvVerMais"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="5dp"
                android:fontFamily="@font/fontpoppins"
                android:text="Ver mais"
                android:textColor="#477740"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- ===== DIVISOR ===== -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#1A477740" />

            <!-- ===== STATUS COM BORDA ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/fontpoppins"
                    android:text="Status: disponível"
                    android:textColor="#6F7880"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ===== AVALIAÇÃO ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvNota"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fontpoppins"
                            android:text="5,0"
                            android:textColor="#477740"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:src="@drawable/estrelaavaliacao"
                                android:contentDescription="estrela" />
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/estrelaavaliacao"
                                android:contentDescription="estrela" />
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/estrelaavaliacao"
                                android:contentDescription="estrela" />
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/estrelaavaliacao"
                                android:contentDescription="estrela" />
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/estrelaavaliacao"
                                android:contentDescription="estrela" />

                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/fontpoppins"
                        android:text="Nota"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        android:paddingStart="2dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnAvaliar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Avaliar"
                    android:textColor="#6F7880"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/fontpoppins"
                    android:background="@drawable/bg_chip_verde" />

            </LinearLayout>

            <!-- ===== BOTÃO RESERVAR ===== -->
            <Button
                android:id="@+id/btnReservar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:backgroundTint="#477740"
                android:fontFamily="@font/fontpoppins"
                android:letterSpacing="0.04"
                android:text="Reservar"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== CAPA DO LIVRO + FAVORITO (filho direto do CoordinatorLayout) ===== -->
    <!-- Fica por CIMA de tudo, sobrepondo verde e branco livremente -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="100dp">

        <androidx.cardview.widget.CardView
            android:layout_width="250dp"
            android:layout_height="350dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="12dp"
            app:cardUseCompatPadding="true"
            >

            <ImageView
                android:id="@+id/imgCapaLivro"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Capa do livro"
                android:scaleType="fitXY"
                android:src="@drawable/bibliotecadetalhes" />

        </androidx.cardview.widget.CardView>

        <!-- Botão favorito sobreposto na borda inferior da capa -->
        <ImageView
            android:id="@+id/btnFavorito"
            android:layout_width="70dp"
            android:layout_height="80dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="-18dp"
            android:padding="9dp"
            android:src="@drawable/ic_favorite_border"
            android:elevation="16dp"
            android:contentDescription="Favoritar" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>