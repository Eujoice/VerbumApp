<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:id="@+id/detalhesLivroLayout"
    tools:context=".ui.DetalhesLivrosFragment">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:background="@drawable/bg_header_perfil"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <!-- Botão Voltar -->
        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/setavoltarpag"
            app:tint="#FFFFFF" />

        <!-- Título da página -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fontpoppins"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Detalhes"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ===== CARD BRANCO PRINCIPAL (sobrepõe o header) ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="155dp"
        android:paddingBottom="24dp"
        android:fillViewport="true"
        android:background="@drawable/bg_card_menu"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- ===== CAPA DO LIVRO (fica no topo, saindo do card) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_marginTop="-60dp">

                <!-- Sombra / Card da capa -->
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="175dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="8dp"
                    app:cardUseCompatPadding="true"
                  >
                    <ImageView
                        android:id="@+id/imgCapaLivro"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Capa do livro"
                        android:scaleType="fitXY"
                        android:src="@drawable/bibliotecadetalhes" />

                </androidx.cardview.widget.CardView>

                <!-- Ícone de favorito -->
                <ImageView
                    android:id="@+id/btnFavorito"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/ic_favorite_border"
                    android:contentDescription="Favoritar" />

            </LinearLayout>

            <!-- ===== TÍTULO E AUTOR ===== -->
            <TextView
                android:id="@+id/tvTituloLivro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/fontpoppins"
                android:gravity="center"
                android:text="Biblioteca da Meia Noite"
                android:textColor="#477740"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAutorLivro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/fontpoppins"
                android:gravity="center"
                android:text="Emily Bronte"
                android:textColor="#888888"
                android:textSize="13sp" />

            <!-- ===== DIVISOR ===== -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:layout_marginStart="5dp"
                android:background="#1A477740" />

            <!-- ===== DESCRIÇÃO ===== -->
            <TextView
                android:id="@+id/tvDescricaoLivro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/fontpoppins"
                android:lineSpacingMultiplier="1.5"
                android:maxLines="5"
                android:ellipsize="end"
                android:text="Clássico eterno da ficção científica, Flores para Algernon é um dos livros mais tocantes já escritos. A história de Charlie Gordon, um jovem com deficiência intelectual submetido a uma cirurgia experimental para aumentar sua inteligência, é narrada em forma de diário e transforma o leitor por completo."
                android:textColor="#555555"
                android:textSize="13sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp" />

            <!-- ===== DIVISOR ===== -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="5dp"
                android:background="#1A477740" />

            <!-- ===== STATUS ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/fontpoppins"
                    android:text="Status: disponível"
                    android:textColor="#477740"
                    android:textSize="15sp"
                    android:textStyle="bold" />



            </LinearLayout>



            <!-- ===== AVALIAÇÃO ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingBottom="15dp">

                <!-- Nota + Estrelas -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvNota"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fontpoppins"
                            android:text="4,0"
                            android:textColor="#477740"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp" />


                        <!-- Estrelas -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingBottom="6dp">

                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:src="@drawable/estrelaavaliacao"
                                android:contentDescription="estrela" />
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/estrelaavaliacao"
                                android:contentDescription="estrela" />
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/estrelaavaliacao"
                                android:contentDescription="estrela" />
                            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                                android:layout_marginStart="2dp"
                                android:src="@drawable/estrelaavaliacao"
                                android:contentDescription="meia estrela" />
                            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                                android:layout_marginStart="2dp"
                                android:layout_marginTop="-3sp"
                                android:src="@drawable/star_filled"
                                android:contentDescription="estrela vazia" />

                        </LinearLayout>

                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/fontpoppins"
                        android:text="Nota"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        android:paddingStart="3dp" />

                </LinearLayout>

                <!-- Botão Avaliar -->
                <TextView
                    android:id="@+id/btnAvaliar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Avaliar"
                    android:textColor="#477740"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/fontpoppins"
                    android:background="@drawable/bg_chip_verde" />

            </LinearLayout>


            <Button
                android:id="@+id/btnReservar"
                android:layout_width="360dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:backgroundTint="#477740"
                android:fontFamily="@font/fontpoppins"
                android:letterSpacing="0.04"
                android:text="Reservar"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>