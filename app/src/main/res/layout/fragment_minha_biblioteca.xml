<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:id="@+id/minhaBibliotecaFragment"
    tools:context=".ui.auth.MinhaBibliotecaFragment">

    <!-- header-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="16dp"
        android:background="@drawable/bg_header_perfil">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:layout_marginTop="60dp"
            android:fontFamily="@font/fontpoppins"
            android:gravity="center"
            android:text="@string/minha_biblioteca_titulo"
            android:textColor="#FFFFFF"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />



    </LinearLayout>

    <!-- card branco -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="175dp"
        android:paddingBottom="16dp"
        android:fillViewport="true"
        android:background="@drawable/bg_card_menu"
        android:clipToOutline="true"
        android:contentDescription="Menu da Minha Biblioteca">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">
            <!-- sem android:background aqui -->

            <!-- cabeçalho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="5dp"
                android:paddingTop="4dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/fontpoppins"
                    android:text="@string/minha_biblioteca_titulos_reservados"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#477740" />

                <!-- contador titulos-->
                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/fontpoppins"
                    android:background="@drawable/bg_badge_verde" />

            </LinearLayout>

            <!-- divisior -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="16dp"
                android:background="#1A477740" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <!-- livro 1 -->
                    <LinearLayout
                        android:layout_width="115dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginEnd="14dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="105dp"
                            android:layout_height="155dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="4dp"
                            app:cardUseCompatPadding="true">

                            <ImageView
                                android:id="@+id/imgBook1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Crime e Castigo"
                                android:background="@drawable/crime"
                                android:scaleType="fitXY" />

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Crime e Castigo"
                            android:textAlignment="center"
                            android:textSize="12sp"
                            android:textColor="#477740"
                            android:fontFamily="@font/fontpoppins"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Dostoiévski"
                            android:textAlignment="center"
                            android:textSize="11sp"
                            android:textColor="#888888"
                            android:fontFamily="@font/fontpoppins"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- livro 2 -->
                    <LinearLayout
                        android:layout_width="115dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginEnd="14dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="105dp"
                            android:layout_height="155dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="4dp"
                            app:cardUseCompatPadding="true">

                            <ImageView
                                android:id="@+id/imgBook2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="O cavaleiro"
                                android:src="@drawable/ocavaleiro"
                                android:scaleType="fitXY" />

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="O Cavaleiro dos Sete Reinos"
                            android:textAlignment="center"
                            android:textSize="12sp"
                            android:textColor="#477740"
                            android:fontFamily="@font/fontpoppins"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="G.R.R. Martin"
                            android:textAlignment="center"
                            android:textSize="11sp"
                            android:textColor="#888888"
                            android:fontFamily="@font/fontpoppins"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- livro 3 -->
                    <LinearLayout
                        android:layout_width="115dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginEnd="14dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="105dp"
                            android:layout_height="155dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="4dp"
                            app:cardUseCompatPadding="true">

                            <ImageView
                                android:id="@+id/imgBook3"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/apaciente"
                                android:contentDescription="A paciente silenciosa"
                                android:scaleType="fitXY" />

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="A Paciente Silenciosa"
                            android:textAlignment="center"
                            android:textSize="12sp"
                            android:textColor="#477740"
                            android:fontFamily="@font/fontpoppins"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Alex Michaelides"
                            android:textAlignment="center"
                            android:textSize="11sp"
                            android:textColor="#888888"
                            android:fontFamily="@font/fontpoppins"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- espaçador entre seções -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="0dp"
                android:background="#1A477740" />

            <!-- cabeçalho2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="5dp"
                android:paddingTop="20dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/fontpoppins"
                    android:text="@string/minha_biblioteca_titulos_pendentes"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#477740" />

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/fontpoppins"
                    android:background="@drawable/bg_badge_verde" />

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="115dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginEnd="14dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="105dp"
                            android:layout_height="155dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="4dp"
                            app:cardUseCompatPadding="true">

                            <ImageView
                                android:id="@+id/imgBook4"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/domquixote"
                                android:contentDescription="Dom Quixote"
                                android:scaleType="fitXY" />

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Dom Quixote"
                            android:textAlignment="center"
                            android:textSize="12sp"
                            android:textColor="#477740"
                            android:fontFamily="@font/fontpoppins"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Miguel de Cervantes"
                            android:textAlignment="center"
                            android:textSize="11sp"
                            android:textColor="#888888"
                            android:fontFamily="@font/fontpoppins"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <!-- status -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_gravity="center_horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="Pendente"
                            android:textSize="10sp"
                            android:textColor="#477740"
                            android:fontFamily="@font/fontpoppins"
                            android:background="@drawable/bg_chip_verde" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="115dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginEnd="14dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="105dp"
                            android:layout_height="155dp"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="4dp"
                            app:cardUseCompatPadding="true">

                            <ImageView
                                android:id="@+id/imgBook5"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/frankenstein"
                                android:contentDescription="Frankenstein"
                                android:scaleType="fitXY" />

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Frankenstein"
                            android:textAlignment="center"
                            android:textSize="12sp"
                            android:textColor="#477740"
                            android:fontFamily="@font/fontpoppins"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Mary Shelley"
                            android:textAlignment="center"
                            android:textSize="11sp"
                            android:textColor="#888888"
                            android:fontFamily="@font/fontpoppins"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_gravity="center_horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="Pendente"
                            android:textSize="10sp"
                            android:textColor="#477740"
                            android:fontFamily="@font/fontpoppins"
                            android:background="@drawable/bg_chip_verde" />

                    </LinearLayout>



                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>