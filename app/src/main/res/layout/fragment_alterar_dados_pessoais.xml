<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- header verde -->
    <LinearLayout
        android:id="@+id/headerPerfil"
        android:layout_width="match_parent"
        android:layout_height="263dp"
        android:background="#477740"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/btnVoltar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Voltar"
                android:src="@drawable/setavoltarpag"
                app:tint="#FFFFFF"/>

        </RelativeLayout>

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_avatar_circle"
                android:padding="16dp"
                android:src="@drawable/ic_perfil2"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvNomeUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/fontpoppins"
            android:text="@string/perfil_nome_exemplo"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- card branco -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="595dp"
        android:layout_marginTop="230dp"
        android:background="@drawable/bg_card_menu"
        android:clipToOutline="true"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Nome de usuário -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/fontpoppins"
                android:text="@string/alterar_dados_nome_usuario_label"
                android:textColor="#477740"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etNomeUsuario"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edit2_txt"
                android:fontFamily="@font/fontpoppins"
                android:text="@string/alterar_dados_hint_nome"
                android:inputType="textPersonName"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="13sp" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/fontpoppins"
                android:text="@string/alterar_dados_email_label"
                android:textColor="#477740"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edit2_txt"
                android:fontFamily="@font/fontpoppins"
                android:hint="@string/alterar_dados_hint_email"
                android:inputType="textEmailAddress"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="13sp" />

            <!-- Telefone -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/fontpoppins"
                android:text="@string/alterar_dados_telefone_label"
                android:textColor="#477740"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etTelefone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_edit2_txt"
                android:fontFamily="@font/fontpoppins"
                android:hint="@string/alterar_dados_hint_telefone"
                android:inputType="phone"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="13sp" />

            <!-- Endereço + Número lado a lado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false"
                android:weightSum="1">

                <!-- Endereço (70% da largura) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.68"
                    android:orientation="vertical"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/fontpoppins"
                        android:text="@string/alterar_dados_endereco_label"
                        android:textColor="#477740"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etEndereco"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_edit2_txt"
                        android:fontFamily="@font/fontpoppins"
                        android:hint="@string/alterar_dados_hint_endereco"
                        android:inputType="textPostalAddress"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Número (30% da largura) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.32"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/fontpoppins"
                        android:text="@string/alterar_dados_numero_label"
                        android:textColor="#477740"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etNumero"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_edit2_txt"
                        android:fontFamily="@font/fontpoppins"
                        android:hint="@string/alterar_dados_hint_numero"
                        android:inputType="number"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- CPF -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/fontpoppins"
                android:text="@string/alterar_dados_cpf_label"
                android:textColor="#477740"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etCpf"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_edit2_txt"
                android:fontFamily="@font/fontpoppins"
                android:hint="@string/alterar_dados_hint_cpf"
                android:inputType="number"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="13sp" />

            <!-- Botão Salvar -->
            <Button
                android:id="@+id/btnSalvar"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#354A2B"
                android:fontFamily="@font/fontpoppins"
                android:text="@string/btn_salvar"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="26dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>