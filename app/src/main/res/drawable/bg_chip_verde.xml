<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camada de sombra (maior, mais escura, levemente deslocada) -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="3dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#C8CDD2" />
        </shape>
    </item>

    <!-- Fundo principal por cima, menor, deixando a sombra aparecer em todos os lados -->
    <item
        android:left="4dp"
        android:top="2dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

</layer-list>