<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/splashFragment">

    <action
        android:id="@+id/action_global_to_acervoFragment"
        app:destination="@+id/fragment_acervo"/>

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.verbumteste.ui.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_splashFragment_to_fragment_acervo"
            app:destination="@id/fragment_acervo"/>
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.verbumteste.ui.auth.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_fragment_acervo"
            app:destination="@id/fragment_acervo"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>


    <fragment
        android:id="@+id/minhaBibliotecaFragment"
        android:name="com.example.verbumteste.ui.auth.MinhaBibliotecaFragment"
        android:label="fragment_minha_biblioteca"
        tools:layout="@layout/fragment_minha_biblioteca" />

    <fragment
        android:id="@+id/dadosPessoaisFragment"
        android:name="com.example.verbumteste.ui.DadosPessoaisFragment"
        android:label="fragment_dados_pessoais"
        tools:layout="@layout/fragment_dados_pessoais">
        <action
            android:id="@+id/action_dadosPessoaisFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/dadosPessoaisFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_dadosPessoaisFragment_to_alterarDadosPessoaisFragment"
            app:destination="@id/alterarDadosPessoaisFragment" />
        <action
            android:id="@+id/action_dadosPessoaisFragment_to_favoritosFragment"
            app:destination="@id/favoritosFragment" />
        <action
            android:id="@+id/action_dadosPessoaisFragment_to_historicoEmprestimoFragment"
            app:destination="@id/historicoEmprestimoFragment" />
        <action
            android:id="@+id/action_dadosPessoaisFragment_to_alterarSenhaFragment"
            app:destination="@id/alterarSenhaFragment" />
    </fragment>

    <fragment
        android:id="@+id/fragment_acervo"
        android:name="com.example.verbumteste.FragmentAcervo"
        android:label="fragment_acervo"
        tools:layout="@layout/fragment_acervo">
        <action
            android:id="@+id/action_acervo_to_biblioteca"
            app:destination="@id/minhaBibliotecaFragment" />
        <action
            android:id="@+id/action_acervo_to_perfil"
            app:destination="@id/dadosPessoaisFragment" />
        <action
            android:id="@+id/action_fragment_acervo_to_detalhesLivroFragment"
            app:destination="@id/detalhesLivroFragment" />
        <action
            android:id="@+id/action_fragment_acervo_to_pesquisaFragment"
            app:destination="@id/pesquisaFragment"/>
    </fragment>
    <fragment
        android:id="@+id/detalhesLivroFragment"
        android:name="com.example.biblioteca.ui.DetalhesLivroFragment"
        android:label="DetalhesLivroFragment" />
    <fragment
        android:id="@+id/pesquisaFragment"
        android:name="com.example.verbumteste.PesquisaFragment"
        android:label="fragment_pesquisa"
        tools:layout="@layout/fragment_pesquisa">
        <action
            android:id="@+id/action_pesquisaFragment_to_detalhesLivroFragment"
            app:destination="@id/detalhesLivroFragment" />

    </fragment>
    <fragment
        android:id="@+id/alterarDadosPessoaisFragment"
        android:name="com.example.verbumteste.AlterarDadosPessoaisFragment"
        android:label="AlterarDadosPessoaisFragment" />
    <fragment
        android:id="@+id/favoritosFragment"
        android:name="com.example.verbumteste.FavoritosFragment"
        android:label="FavoritosFragment" >
        <action
            android:id="@+id/action_favoritosFragment_to_detalhesLivroFragment"
            app:destination="@id/detalhesLivroFragment" />
    </fragment>
    <fragment
        android:id="@+id/historicoEmprestimoFragment"
        android:name="com.example.verbumteste.HistoricoEmprestimoFragment"
        android:label="fragment_historico_emprestimo"
        tools:layout="@layout/fragment_historico_emprestimo" />
    <fragment
        android:id="@+id/alterarSenhaFragment"
        android:name="com.example.verbumteste.AlterarSenhaFragment"
        android:label="AlterarSenhaFragment" />


</navigation>